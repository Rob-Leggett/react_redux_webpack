{
  "name": "react-redux-client",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "A modern React + Redux Toolkit client built with webpack",
  "scripts": {
    "dev": "webpack serve --mode development",
    "build": "tsc --noEmit && webpack --mode production",
    "preview": "webpack serve --mode production",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "type-check": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Rob-Leggett/react_redux_webpack.git"
  },
  "author": "Robert Leggett",
  "license": "MIT",
  "homepage": "https://github.com/Rob-Leggett/react_redux_webpack",
  "bugs": {
    "url": "https://github.com/Rob-Leggett/react_redux_webpack/issues"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.0",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "css-loader": "^7.1.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "html-webpack-plugin": "^5.6.8",
    "jsdom": "^30.1.3",
    "mini-css-extract-plugin": "^2.10.2",
    "react-refresh": "^0.19.0",
    "react-refresh-typescript": "^2.0.12",
    "sass": "^1.106.1",
    "sass-loader": "^17.0.1",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.1.0"
  },
  "engines": {
    "node": ">=26"
  }
}
